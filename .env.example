# Server-only. Obtain the token from the project owner; never use NEXT_PUBLIC_.
ZENIFIELD_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ZENIFIELD_GATEWAY_TOKEN=REPLACE_WITH_SERVER_ONLY_TOKEN
KAKAO_REST_API_KEY=REPLACE_WITH_SERVER_ONLY_TOKEN
OPENAI_API_KEY=REPLACE_WITH_SERVER_ONLY_TOKEN
OPENAI_MODEL=gpt-6-luna
# supabase-email = 회사 계정(이메일+비밀번호) 로그인. 비우면 Sites(ChatGPT) 로그인
ZENIFIELD_AUTH_PROVIDER=supabase-email
